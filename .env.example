# ─── WhatsApp Cloud API (Meta) ──────────────────────────────
# Meta dashboard → WhatsApp → API Setup

# The temporary token expires in 24 HOURS. For anything beyond a
# demo, create a System User token instead — it does not expire.
# MUST be on a single line. See README → "Operational traps".
WHATSAPP_TOKEN=your_token_here

PHONE_NUMBER_ID=000000000000000

# You invent this string. It must match what you type into the
# Meta webhook config exactly.
VERIFY_TOKEN=pick_any_random_string

# Meta dashboard → App Settings → Basic → App Secret.
# Optional locally; REQUIRED in production — without it the
# webhook accepts forged requests from anyone.
APP_SECRET=your_app_secret_here

# ─── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Server ─────────────────────────────────────────────────
# Optional: override the reviewed default. See docs/graph-api-migration.md.
GRAPH_VERSION=v25.0
PORT=3000
